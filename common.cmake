set(inline_filter "Inline Files")
set(header_filter "Header Files")
set(source_filter "Source Files")

macro(set_filters)
  foreach(file ${ARGN})
    string(FIND ${file} ".inl" findInlineIdx)
    string(FIND ${file} ".h" findHeaderIdx)
    if(findInlineIdx GREATER 0)
      set(topFilter ${inline_filter})
    elseif(findHeaderIdx GREATER 0)
      set(topFilter ${header_filter})
    else()
      set(topFilter ${source_filter})
    endif()

    set(subFilter)
    string(FIND ${file} "/" fIdx REVERSE)
    if(fIdx GREATER 0)
      string(SUBSTRING ${file} 0 ${fIdx} subFilter)
    endif()
    source_group(${topFilter}/${subFilter} FILES ${file})
  endforeach()
endmacro()